<html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#090812"><meta name="description" content="آرکانا؛ تجربه‌ای رازآلود برای آشنایی با نمادهای تاروت، چیدمان کارت‌ها و دفتر شخصی."><title>آرکانا | دنیای تاروت</title><link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#090812;--panel:#151220;--line:#ffffff1b;--gold:#d5b779;--text:#f4efe6;--muted:#aaa1b5}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -10%,#30213c,#110e1b 45%,var(--bg) 80%);color:var(--text);font-family:Vazirmatn,Tahoma,sans-serif;min-height:100vh}button,input,select{font:inherit}button{cursor:pointer}.shell{width:min(1100px,92%);margin:auto}.topbar{height:76px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.brand{font-size:22px;font-weight:800;letter-spacing:2px;color:#f1dba8;text-decoration:none}.nav{display:flex;gap:5px}.nav button{background:none;border:0;color:var(--muted);padding:10px 12px;border-radius:20px;font-size:12px}.nav button.active,.nav button:hover{color:#f1dba8;background:#d5b77912}.hero{text-align:center;padding:65px 10px 35px}.eyebrow{font-size:11px;letter-spacing:4px;color:var(--gold)}h1{font-size:clamp(42px,8vw,76px);margin:12px 0;color:#f1dba8}.hero p,.muted{color:var(--muted);font-size:13px;line-height:2;max-width:680px;margin:auto}.section{padding:28px 0 50px}.section h2{font-size:22px}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.feature,.panel{border:1px solid var(--line);border-radius:16px;background:linear-gradient(145deg,#211a2d,#110f19);padding:18px}.feature{min-height:165px}.feature b{display:block;margin:7px 0}.feature p{font-size:12px;line-height:2;color:var(--muted)}.feature button,.btn{border:1px solid #d5b77988;color:#f1dba8;background:#d5b77910;border-radius:24px;padding:9px 15px;font-size:12px}.btn.primary{background:var(--gold);color:#17111c;font-weight:700}.tabs,.actions,.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:14px 0}.tab{border:1px solid var(--line);background:#ffffff09;color:var(--muted);padding:9px 13px;border-radius:20px;font-size:12px}.tab.active{background:var(--gold);color:#17111c}.draw-area{display:flex;justify-content:center;gap:12px;flex-wrap:wrap;padding:18px 0;min-height:180px}.tarot-card{width:140px;min-height:205px;border:1px solid #d5b779aa;border-radius:12px;background:linear-gradient(150deg,#382a49,#171221);display:flex;flex-direction:column;align-items:center;text-align:center;padding:13px;box-shadow:0 10px 25px #0006}.tarot-card .symbol{font-size:48px;color:#f1dba8;margin:16px}.tarot-card strong{font-size:13px}.tarot-card small,.position{font-size:10px;color:#c2b4ce;margin-top:7px}.position{margin-top:auto;color:var(--gold)}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.meaning{border:1px solid var(--line);border-radius:12px;padding:13px;background:#ffffff06}.meaning h3{font-size:13px;color:#f1dba8}.meaning p{font-size:12px;line-height:2;color:#c6bfcc}.search,.select{background:#1b1728;border:1px solid var(--line);color:var(--text);border-radius:22px;padding:10px 14px}.search{flex:1;min-width:170px}.deck{display:grid;grid-template-columns:repeat(6,1fr);gap:9px}.deck-card{position:relative;background:linear-gradient(145deg,#211a2d,#13101c);border:1px solid var(--line);border-radius:12px;padding:12px 6px;min-height:130px;color:var(--text)}.deck-card .symbol{font-size:30px;color:#f1dba8}.deck-card strong{display:block;font-size:11px}.deck-card small{font-size:9px;color:var(--muted)}.fav{position:absolute;top:5px;left:8px;color:var(--gold)}.history-list{display:grid;gap:8px}.history-item{display:flex;justify-content:space-between;gap:10px;border:1px solid var(--line);border-radius:12px;padding:12px;font-size:12px}.history-item small{display:block;color:var(--muted);margin-top:5px}.history-item button{border:0;background:none;color:var(--gold)}.empty{text-align:center;color:var(--muted);padding:30px}.disclaimer{border:1px solid #d5b77944;background:#d5b7790b;border-radius:12px;padding:13px;color:#c4b8ca;font-size:11px;line-height:2;margin:20px 0}.footer{border-top:1px solid var(--line);padding:20px 0 30px;color:#81798b;font-size:11px;display:flex;justify-content:space-between}.hidden{display:none!important}.modal{position:fixed;inset:0;background:#05040bdf;z-index:5;display:grid;place-items:center;padding:18px}.modal-box{width:min(450px,100%);background:#171321;border:1px solid #d5b77988;border-radius:16px;padding:24px;position:relative}.modal-close{position:absolute;left:12px;top:8px;background:none;border:0;color:var(--muted);font-size:23px}.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#f1dba8;color:#17111c;border-radius:20px;padding:10px 18px;font-size:12px;z-index:8}
